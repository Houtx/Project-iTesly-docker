# ==============================================================================
# Project-iTesly 一键部署环境变量模板
# 建议使用 ./install.sh 自动生成随机强密码，无需手动填写！
# ==============================================================================

# TeslaMate 加密密钥与数据库超级管理员密码（由 install.sh 自动生成）
ENCRYPTION_KEY=replace-with-random-encryption-key
DATABASE_PASS=replace-with-random-postgres-password

# iTesly API 只读数据库账号密码（与 TeslaMate 分离，仅读全库 + 写充电费用）
ITESLY_DATABASE_PASS=replace-with-random-itesly-db-password

# iTesly 移动端 App 连接令牌（填入 iOS / Android App 中的“访问令牌”）
ITESLY_API_TOKEN=replace-with-random-api-token

# 可选：用于发布自建更新包管理接口的独立令牌
ITESLY_PUBLISH_TOKEN=replace-with-random-publish-token

# 时区（默认 Asia/Shanghai）
TZ=Asia/Shanghai

# 对外映射端口（如端口冲突可修改）
TESLAMATE_PORT=4000
GRAFANA_PORT=3000
ITESLY_API_PORT=8080

# 仅本机/反向代理访问可设为 127.0.0.1；局域网手机直接访问可设为 0.0.0.0
HOST_BIND=0.0.0.0

# 可选：自定义公网反代域名（如 https://itesly.example.com），留空不影响正常使用
PUBLIC_BASE_URL=

# 可选：OTA 推送提醒 MQTT 配置（默认已连接内置 mosquitto）
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=teslamate
